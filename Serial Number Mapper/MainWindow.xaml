<Window x:Class="Serial_Number_Mapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Serial_Number_Mapper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnUpload" Content="Upload CSV" HorizontalAlignment="Left" Margin="198,166,0,0" VerticalAlignment="Top" IsEnabled="{Binding IsEnabled.TrueString, ElementName=btnUpload}" Click="btnUpload_Click"/>
        <Button x:Name="btnProcessCSV" Content="Process" HorizontalAlignment="Left" Margin="213,230,0,0" VerticalAlignment="Top" Click="btnProcessCSV_Click"/>
        <TextBox x:Name="csvContent" HorizontalAlignment="Left" Margin="280,231,0,0" TextWrapping="Wrap" Text="Content" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
